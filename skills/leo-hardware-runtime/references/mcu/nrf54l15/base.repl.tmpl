nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

rram: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00200000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00080000

ficr: Memory.MappedMemory @ sysbus 0x00FFC000
    size: 0x00004000

uart_c6000: Python.PythonPeripheral @ sysbus 0x400C6000
    size: 0x1000
    initable: true
    filename: "${MODEM_SCRIPT_PATH}"

clock: Python.PythonPeripheral @ sysbus 0x4010E000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    regs = {}
elif request.IsRead:
    off = request.Offset
    if 0x100 <= off < 0x180:
        request.Value = 1
    elif 0x400 <= off < 0x480:
        request.Value = 0x00010001
    else:
        request.Value = regs.get(off, 0)
elif request.IsWrite:
    regs[request.Offset] = request.Value
'''

grtc: Python.PythonPeripheral @ sysbus 0x400E2000
    size: 0x1000
    initable: true
    filename: "${GRTC_RTT_SCRIPT_PATH}"

cracen: Python.PythonPeripheral @ sysbus 0x40059000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    seed = 0x12345678
    regs = {}
elif request.IsRead:
    off = request.Offset
    if off == 0x530:
        request.Value = 0x02
    elif off == 0x504:
        request.Value = 0x10
    elif off >= 0x580:
        seed = (seed * 1103515245 + 12345) & 0xFFFFFFFF
        request.Value = seed
    else:
        request.Value = regs.get(off, 0)
elif request.IsWrite:
    regs[request.Offset] = request.Value
'''
